{
  "name": "om-toolload",
  "version": "0.1.0",
  "private": true,
  "description": "Benchmark: does Mastra Observational Memory keep exact facts from tool outputs, and at what token cost?",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:cases": "tsx scripts/build-cases.ts",
    "build:audit": "tsx scripts/build-audit.ts",
    "audit:scorers": "tsx src/audit.ts",
    "bench": "tsx src/run.ts",
    "bench:fix": "tsx src/run.ts --conditions C5,C6",
    "report": "tsx src/report.ts",
    "spike": "tsx scripts/spike.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "bench:observer": "tsx src/run.ts --conditions C4,C5 --runs 1 --observer anthropic/claude-haiku-5-5 --ledger results/observer-check.jsonl --cases exact-001,exact-002,exact-003,exact-004,exact-005,temporal-004,multi-001,update-001,distractor-001,distractor-005"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@mastra/core": "1.78.0",
    "@mastra/libsql": "1.26.2",
    "@mastra/memory": "1.38.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "tokenx": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.9.0"
}
