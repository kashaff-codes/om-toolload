# Only the judge uses Anthropic; everything else runs on local Ollama.
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=12288
JUDGE_MODEL=claude-haiku-5-5
# Hard cap on Anthropic spend (USD). The runner stops judging when the ledger crosses it.
COST_CAP_USD=2
